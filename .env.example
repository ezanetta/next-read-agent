# Copy to .env and fill in real values. Never commit .env.

# Which LLM provider the agent uses: "gemini" or "claude"
LLM_PROVIDER=gemini

# Required
GEMINI_API_KEY=your-gemini-api-key

# Gemini model: an exact id, not a "-latest" alias (default: gemini-3.5-flash-lite).
# Free-tier limits checked in AI Studio on 2026-11-15:
#   gemini-3.5-flash-lite: 15 requests/min, 500 requests/day  (development and demo)
#   gemini-3.6-flash:       5 requests/min,  20 requests/day  (eval comparisons only)
#   gemini-3.8-flash:       5 requests/min,  20 requests/day  (eval comparisons only)
GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini thinking level: minimal, low, medium or high. Leave commented out to use
# the model's default. Support varies by model (gemini-3.8-flash rejects minimal).
# GEMINI_THINKING_LEVEL=low

# Optional
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_BOOKS_API_KEY=your-google-books-api-key
