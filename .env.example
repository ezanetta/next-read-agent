# Copy to .env and fill in real values. Never commit .env.

# Which LLM provider the agent uses. Only "gemini" is implemented; "claude" is planned.
LLM_PROVIDER=gemini

# Required
GEMINI_API_KEY=your-gemini-api-key

# Gemini model: an exact id, not a "-latest" alias (default: gemini-3.5-flash-lite).
# Free-tier limits checked in AI Studio on 2026-11-15:
#   gemini-3.5-flash-lite: 15 requests/min, 500 requests/day  (development and demo)
#   gemini-3.6-flash:       5 requests/min,  20 requests/day  (eval comparisons only)
#   gemini-3.8-flash:       5 requests/min,  20 requests/day  (eval comparisons only)
GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini thinking level: minimal, low, medium or high. Leave commented out to use
# the model's default. Support varies by model (gemini-3.8-flash rejects minimal).
# GEMINI_THINKING_LEVEL=low

# Embedding model for retrieval over your library (agent_v4). Free tier, checked in AI
# Studio: 100 requests/min, 1,000 requests/day, about 30,000 tokens/min.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Deadlines, in seconds: one LLM request (it then fails and is retried once), and one
# whole recommendation in the demo API (it then ends with a failed event).
# LLM_TIMEOUT_S=60
# RUN_DEADLINE_S=180

# Optional
# For the planned Claude adapter (not used yet)
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# Open Library is used to group editions and translations into works. It asks clients
# to identify themselves: put an email or a project URL here. Leave it commented out to
# turn work-key matching off (the LLM same-work check still runs).
# OPEN_LIBRARY_CONTACT=you@example.com

# Demo API (D-043). Stores: Postgres when DATABASE_URL is set (D-048), else a local
# SQLite file at DEMO_DB_PATH. Migrations are applied on startup (D-049).
# DATABASE_URL=postgresql://book_agent:book_agent@127.0.0.1:5433/book_agent
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=4
# DEMO_DB_PATH=data/demo.sqlite3
# The owner's library, written by `cli export-profile`; never commit it.
# OWNER_PROFILE_PATH=/run/secrets/owner_profile.json
# PROFILE_TTL_DAYS=3
# Comma-separated origins the UI is served from, for CORS.
# FRONTEND_ORIGINS=http://localhost:5173
